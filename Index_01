    <!-- CASE STUDIES SECTION -->
    <section id="case-studies" class="py-20 px-6 bg-slate-100 border-t border-b border-slate-200">
        <div class="max-w-6xl mx-auto">
            <div class="max-w-3xl mb-16">
                <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Recent Technical Engagements</h2>
                <p class="mt-4 text-lg text-slate-600">Real enterprise interventions demonstrating business transformation, measurable system efficiency upgrades, and cost reduction.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                <!-- Case Study 1 -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between">
                    <div class="p-8">
                        <div class="flex items-center justify-between gap-4 mb-4">
                            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-semibold rounded-full border border-emerald-200">
                                <i class="fa-solid fa-chart-line mr-1"></i> +40% Process Efficiency
                            </span>
                            <span class="text-xs font-medium text-slate-500 uppercase tracking-wider font-mono">Automotive Sector</span>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-3">Lead-Time Optimization & Data Centralization</h3>
                        <p class="text-xs font-semibold text-indigo-600 mb-4">Client Focus: German Automotive Tier-1 Supplier</p>
                        
                        <div class="space-y-4 text-sm text-slate-600">
